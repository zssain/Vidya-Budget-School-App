# Vidya licence service — environment (prompts/P10 Step 7). Copy to `.env` for
# local runs, or set these as Fly secrets/[env] in production (docs/DEPLOY-FLY.md).
# `.env*` is gitignored. NEVER commit real secret values.
#
# --- required in production (`serve`) -------------------------------------------

# ed25519 PRIVATE signing key (base64 32-byte seed). Generate with:
#   cargo run -- gen-prod-key      (prints the private seed + the public key)
# The matching PUBLIC key goes into src-tauri/build-config/release.json.
LICENCE_SIGNING_KEY=

# Symmetric key (base64, 32 bytes) that encrypts activation codes at rest so the
# Account page can re-display them. Generate with:  cargo run -- gen-enc-key
LICENCE_CODE_ENC_KEY=

# Shared secret with cloud/relay — MUST be byte-identical on both services.
#   openssl rand -base64 48
RELAY_SHARED_KEY=

# Bootstrap admin (created on first start if that email doesn't exist).
LICENCE_ADMIN_EMAIL=
LICENCE_ADMIN_PASSWORD=

# --- storage + networking (defaults shown; Fly sets these in [env]) ------------

# Directory holding the SQLite store (the Fly volume mount). DB = <dir>/vidya-licence.db.
LICENCE_DATA_DIR=/data
# Or set an explicit DB path (wins over LICENCE_DATA_DIR):
# LICENCE_DB=/data/vidya-licence.db

# Host + port to bind. LICENCE_BIND may be a full host:port, or a host with LICENCE_PORT.
LICENCE_BIND=0.0.0.0
LICENCE_PORT=8787

# Public base URL (for absolute links; optional).
LICENCE_BASE_URL=https://api.vidya.zuhairhussain.com

# Sessions + cookies. COOKIE_SECURE must stay true in production (TLS at the proxy).
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# Optional comma-separated IP allowlist for /admin (empty = allow any).
# ADMIN_IP_ALLOWLIST=203.0.113.4,203.0.113.5

# --- downloads page ------------------------------------------------------------

# Path to releases.json (produced by the release workflow). Unset = "no releases yet".
# RELEASES_JSON=/data/releases.json

# --- owner business text (placeholders until filled — Standing Rule 4) ---------

COMPANY_NAME=[Company name]
SUPPORT_EMAIL=[Support email]
SUPPORT_PHONE=[Support phone]
UPI_ID=[UPI ID]
PRICE_TEXT=[Price]
TERMS_URL=[Terms URL]
# Path to the owner's UPI QR image (png/jpg/svg) shown on the pay page.
# UPI_QR_PATH=/data/upi-qr.png
