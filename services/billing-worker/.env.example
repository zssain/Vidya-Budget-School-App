# Vidya billing worker — PLACEHOLDERS ONLY. Every value is server-only.
# Classification: see docs/implementation/owner-portal.md § Configuration.

# SECRET — a login role that is a member of vidya_worker
BILLING_WORKER_DATABASE_URL=postgres://vidya_worker_login:<password>@localhost:55432/vidya_billing
# Admin connection used ONLY by `npm run migrate` (not by the worker process)
# BILLING_MIGRATION_DATABASE_URL=postgres://postgres@localhost:55432/vidya_billing

# Razorpay — must match the checkout deployment's mode; test and live keys are distinct
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_<placeholder>
RAZORPAY_KEY_SECRET=<test-key-secret>
# Optional merchant check: events whose account_id differs are rejected
# RAZORPAY_ACCOUNT_ID=acc_<placeholder>

# Resend — SECRET API key + a sender on a domain verified in Resend
RESEND_API_KEY=re_<placeholder>
BILLING_FROM_EMAIL=Vidya Licences <licences@<verified-domain>>

# Tuning (defaults shown)
# WORKER_ID=billing-worker@host:pid
# WORKER_LEASE_SECONDS=120
# WORKER_POLL_MS=2000
# WORKER_SWEEP_SECONDS=60
# WEBHOOK_RETENTION_DAYS=30
# WORKER_HEALTH_PORT=8787   # binds 127.0.0.1 only
