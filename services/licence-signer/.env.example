# Vidya licence signer — example environment. PLACEHOLDERS ONLY: never commit real values.
# See docs/implementation/licence-signer.md.

# Path to the ed25519 signing key file in tools/licence-maker's format
# (base64 of the 32-byte seed). Mode 0600/0400, owned by the signer user.
# The key itself must NEVER be put in an environment variable.
LICENCE_SIGNING_KEY_FILE=/run/secrets/licence-signing.key

# Short id recorded in licence_issuances.signer_key_id (1-64 chars of A-Za-z0-9._-).
LICENCE_SIGNING_KEY_ID=REPLACE-key-id-e.g.-owner-2026-a

# sha256:<hex> of the raw 32-byte public key. Comma-separate several during a
# rotation. Get it with: licence-signer fingerprint /path/to/public.key
EXPECTED_PUBLIC_KEY_FINGERPRINT=sha256:REPLACE-with-64-hex-chars

# A Postgres login role that is a member of vidya_signer (and nothing more).
SIGNER_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=verify-full

# Optional.
# SIGNER_POLL_INTERVAL_SECS=5
# SIGNER_WORKER_ID=signer-1
