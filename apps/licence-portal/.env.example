# Vidya licence portal — copy to .env.local (git-ignored). PLACEHOLDERS ONLY.
# No variable here uses the NEXT_PUBLIC_ prefix: nothing is exposed to the browser.
# Classification: see docs/implementation/owner-portal.md § Configuration.

# ---- which surface this deployment serves: owner | checkout | both (both = local dev ONLY)
PORTAL_SURFACE=both

# ---- public configuration (exact origins, no trailing slash)
OWNER_ORIGIN=http://localhost:3000
CHECKOUT_ORIGIN=http://localhost:3000

# ---- database (SECRET) — a login role that is a member of vidya_portal
PORTAL_DATABASE_URL=postgres://vidya_portal_login:<password>@localhost:55432/vidya_billing

# ---- owner surface only -------------------------------------------------------
# Supabase project URL + PUBLISHABLE key (public by design, but used server-side only here)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Immutable Supabase Auth user UUID of THE owner (an allow-list id, not a password)
OWNER_AUTH_USER_ID=<00000000-0000-0000-0000-000000000000>
# NOT needed at runtime. Only for `npm run bootstrap-owner`, in your local shell, once:
# SUPABASE_SECRET_KEY=<sb_secret_...>

# ---- checkout surface only ----------------------------------------------------
RAZORPAY_MODE=test
# Public checkout identifier (sent to the browser by the server in the checkout payload)
RAZORPAY_KEY_ID=rzp_test_<placeholder>
# SECRETS — distinct values for test and live
RAZORPAY_KEY_SECRET=<test-key-secret>
RAZORPAY_WEBHOOK_SECRET=<test-webhook-secret>
CHECKOUT_BRAND_NAME=Vidya
